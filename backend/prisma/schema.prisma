generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  password          String
  username          String    @unique
  previousUsernames String[]
  profile           String
  online            Boolean   @default(false)
  messages          Message[]
  chats             Chat[]
}

model Message {
  id       Int      @id @default(autoincrement())
  date     DateTime @default(now())
  message  String?
  image    String?
  sender   User     @relation(fields: [senderId], references: [id])
  senderId Int
  chat     Chat?    @relation(fields: [chatId], references: [id])
  chatId   Int?
}

model UserFriends {
  id       Int     @id @default(autoincrement())
  user1    Int
  user2    Int
  accepted Boolean @default(false)
}

model Chat {
  id       Int       @id @default(autoincrement())
  name     String?
  messages Message[]
  members  User[]
  date     DateTime  @default(now())
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

// this is an array of all taken usernames throughout every user
model TakenUsernames {
  id       Int    @id @default(autoincrement())
  username String @unique
}
