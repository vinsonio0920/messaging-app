generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int       @id @default(autoincrement())
  email    String    @unique
  password String
  username String    @unique
  profile  String
  online   Boolean
  messages Message[]
  chats    Chat[]
  friends  Friend[]
}

model Friend {
  id     Int  @id @default(autoincrement())
  user   User @relation(fields: [userId], references: [id])
  userId Int
}

model Message {
  id       Int      @id @default(autoincrement())
  date     DateTime @default(now())
  message  String
  sender   User     @relation(fields: [senderId], references: [id])
  senderId Int
  chat     Chat     @relation(fields: [chatId], references: [id])
  chatId   Int
}

model Chat {
  id       Int       @id @default(autoincrement())
  name     String?
  messages Message[]
  members  User[]
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}
