generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int       @id @default(autoincrement())
  email    String    @unique
  password String
  username String    @unique
  profile  String
  online   Boolean   @default(false)
  messages Message[]
  chats    Chat[]
}

model Message {
  id       Int      @id @default(autoincrement())
  date     DateTime @default(now())
  message  String
  sender   User     @relation(fields: [senderId], references: [id])
  senderId Int
  chat     Chat?    @relation(fields: [chatId], references: [id])
  chatId   Int?
}

model UserFriends {
  id       Int     @id @default(autoincrement())
  user1    Int
  user2    Int
  accepted Boolean
}

model Chat {
  id       Int       @id @default(autoincrement())
  name     String?
  messages Message[]
  members  User[]
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}
